{
  "name": "@dsh-web/lanscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scan this LAN for HTTP services from the page itself: unicast probes over fetch, with no helper process and no native code",
  "license": "Apache-2.0",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
